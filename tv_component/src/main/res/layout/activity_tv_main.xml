<?xml version="1.0" encoding="utf-8"?>
<!--
  电视端首页：横屏 + 遥控器操作。
  两个主入口（本地媒体库 / 投屏接收端）做得很大、焦点样式很强，
  下面一排是次要入口（播放历史 / 扫描目录 / 播放器设置 / 应用设置）。

  尺寸按 1080p 电视（约 540dp 高）设计，保证首屏能完整显示、不出滚动条。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="26dp"
        android:paddingEnd="48dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/tv_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tv_subtitle"
            android:textColor="@color/tv_text_secondary"
            android:textSize="15sp" />

        <!-- 主入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/media_library_card"
                android:layout_width="0dp"
                android:layout_height="196dp"
                android:layout_weight="1"
                android:background="@drawable/tv_card_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/tv_local_media"
                    android:src="@drawable/ic_local_storage" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/tv_local_media"
                    android:textColor="@color/tv_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tv_local_media_desc"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/screencast_receiver_card"
                android:layout_width="0dp"
                android:layout_height="196dp"
                android:layout_marginStart="28dp"
                android:layout_weight="1"
                android:background="@drawable/tv_card_selector"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/tv_screencast_receiver"
                    android:src="@drawable/ic_screencast_receiver" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/tv_screencast_receiver"
                    android:textColor="@color/tv_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/screencast_receiver_status_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tv_screencast_receiver_desc"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp" />

                <!-- 手机端"搜索连接"在某些网络下搜不到时，照着这个地址手动输入即可 -->
                <TextView
                    android:id="@+id/screencast_receiver_addr_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/tv_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 次要入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/play_history_btn"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/tv_play_history"
                    android:src="@drawable/ic_play_history" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/tv_play_history"
                    android:textColor="@color/tv_text"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/scan_manager_btn"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/tv_scan_manager"
                    android:src="@drawable/ic_scan_manager" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/tv_scan_manager"
                    android:textColor="@color/tv_text"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/player_setting_btn"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/tv_player_setting"
                    android:src="@drawable/ic_video_player_setting" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/tv_player_setting"
                    android:textColor="@color/tv_text"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/app_setting_btn"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/tv_app_setting"
                    android:src="@drawable/ic_app_setting" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/tv_app_setting"
                    android:textColor="@color/tv_text"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/tv_tips_remote"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
