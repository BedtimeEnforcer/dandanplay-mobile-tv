<?xml version="1.0" encoding="utf-8"?>
<!--
  电视端（遥控器、10 尺观看距离）覆盖的播放器控制栏尺寸。

  为什么用 -television 限定符：
  Android 电视设备（Android TV / 多数电视盒子）的 uiMode 为 UI_MODE_TYPE_TELEVISION，
  系统会优先匹配本目录，因此电视上按钮自动放大，手机端完全不生效、保持原尺寸。

  手机端（无此限定符）继续使用 values/dimens.xml 中的原始尺寸。
-->
<resources>

    <!-- 顶栏：加高，图标随之变大 -->
    <dimen name="player_top_bar_height">72dp</dimen>
    <dimen name="player_top_bar_hidden_translation">-72dp</dimen>
    <dimen name="player_top_action_btn_width">64dp</dimen>
    <dimen name="player_top_title_text_size">20sp</dimen>

    <!-- 底栏：容纳放大后的按钮行 -->
    <dimen name="player_bottom_bar_height">120dp</dimen>
    <dimen name="player_bottom_bar_hidden_translation">120dp</dimen>

    <!-- 进度行 -->
    <dimen name="player_control_progress_row_height">32dp</dimen>
    <dimen name="player_control_progress_row_margin_top">8dp</dimen>
    <dimen name="player_control_seek_margin">120dp</dimen>
    <dimen name="player_control_time_text_size">20sp</dimen>

    <!-- 按钮行：单键 64dp，遥控器远距离也好按 -->
    <dimen name="player_control_btn_size">64dp</dimen>
    <dimen name="player_control_btn_padding">14dp</dimen>
    <dimen name="player_control_btn_margin">12dp</dimen>
    <dimen name="player_control_row_margin_end">24dp</dimen>
    <dimen name="player_control_play_width">88dp</dimen>
    <dimen name="player_control_play_height">64dp</dimen>
    <dimen name="player_control_play_padding">6dp</dimen>
    <dimen name="player_control_text_size">18sp</dimen>
    <dimen name="player_control_text_padding">16dp</dimen>
    <dimen name="player_control_text_drawable_padding">8dp</dimen>

    <!-- 两侧按钮（锁屏、截图）：offset 必须 >= size + margin，否则收起时会露出一条边 -->
    <dimen name="player_control_side_btn_size">64dp</dimen>
    <dimen name="player_control_side_btn_margin">16dp</dimen>
    <dimen name="player_control_side_btn_padding">16dp</dimen>
    <dimen name="player_control_side_btn_offset">90dp</dimen>
    <dimen name="player_control_side_btn_hidden_translation">-90dp</dimen>
</resources>
