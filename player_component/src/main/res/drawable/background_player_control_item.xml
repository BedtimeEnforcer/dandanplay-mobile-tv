<?xml version="1.0" encoding="utf-8"?>
<!--
  播放器控制栏按钮背景（右下角按钮组统一使用）。

  设计要点：
  - state_focused：主题蓝填充 + 浅蓝描边，电视上离得远也能一眼看出焦点在哪
    （图标是白色，所以聚焦底色必须用饱和蓝，不能用浅色底，否则白图标会看不见）
  - state_pressed：保留原来的灰色高亮，手机触摸时按下反馈不变
  - 最外层 ripple：手机上点击有水波纹，触摸行为与原 selector 一致
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33ffffff">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/theme" />
                    <corners android:radius="8dp" />
                    <stroke
                        android:width="3dp"
                        android:color="#E4F0FE" />
                </shape>
            </item>

            <item
                android:drawable="@drawable/background_video_action_item_pressed_color"
                android:state_pressed="true" />

            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/transparent" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
